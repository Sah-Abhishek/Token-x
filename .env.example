# ---------------------------------------------------------------------------
# Copy to .env.local for development, and set the same keys in the Vercel
# project settings (Settings -> Environment Variables) before deploying.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon). Use the POOLED connection string on
# Vercel — serverless functions exhaust a direct connection limit fast.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Clerk — https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk webhook signing secret — Dashboard -> Webhooks -> your endpoint.
# The endpoint URL is https://<your-domain>/api/webhooks/user
# and it must subscribe to user.created, user.updated and user.deleted.
WEBHOOK_SECRET="whsec_..."

# Shared secret for the scheduled limit-order fill runner. Set it and
# /api/orders/run will fill resting orders for people who are not currently
# looking at the site; leave it unset and that endpoint refuses, which is the
# safe default. Vercel Cron sends it automatically once it is set in the
# project's environment variables. Any long random string will do.
#
# Orders still fill without this: reading /api/orders or /dashboard re-prices
# that user's own resting orders first.
CRON_SECRET=""
